# Required for LLM mode (or paste a key into the UI). Without it the app runs in deterministic offline mode.
OPENAI_API_KEY=
# Optional overrides
OPENAI_MODEL=gpt-5.4-nano
# OPENAI_JUDGE_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low
# OPENAI_BASE_URL=
# Business date used for derived facts like "appeal deadline passed" (defaults to today)
# AGENT_TODAY=2026-10-01
# Run the LLM groundedness judge on every live reply (extra call per turn)
LIVE_JUDGE=false
