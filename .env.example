# Any one provider key enables LLM mode (or paste a key into the UI). Without one the app runs in
# deterministic offline mode. The provider is detected from the key prefix.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# Optional overrides
# LLM_PROVIDER=          # openai | anthropic | gemini | openrouter | groq | xai (when the key prefix is ambiguous)
# LLM_MODEL=             # defaults per provider, e.g. gpt-5.4-nano, claude-opus-5-5
# LLM_JUDGE_MODEL=
# LLM_BASE_URL=          # any OpenAI-compatible endpoint (use with LLM_API_KEY)
# LLM_API_KEY=
# OPENAI_REASONING_EFFORT=low
# Business date used for derived facts like "appeal deadline passed" (defaults to today)
# AGENT_TODAY=2026-10-01
# Run the LLM groundedness judge on every live reply (extra call per turn)
LIVE_JUDGE=false
