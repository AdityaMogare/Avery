# Any one provider key enables LLM mode (or paste a key into the UI). Without one the app runs in
# deterministic offline mode. The provider is detected from the key prefix.
# Supported (tested live): OpenAI, Gemini, OpenRouter. Use OpenRouter to reach other model families.
OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Optional per-provider model pins (tried first, then the provider's default chain)
# OPENAI_MODEL=          # default chain: gpt-5.4-nano -> gpt-5.4-mini
# GEMINI_MODEL=          # default chain: gemini-3.8-flash -> gemini-3.5-flash-lite
# OPENROUTER_MODEL=      # default chain: openai/gpt-5.4-nano -> google/gemini-3.8-flash
# Optional overrides
# LLM_PROVIDER=          # openai | gemini | openrouter (when the key prefix is ambiguous)
# LLM_MODEL=             # applies only to the server's own provider
# LLM_JUDGE_MODEL=
# LLM_BASE_URL=          # any OpenAI-compatible endpoint (use with LLM_API_KEY)
# LLM_API_KEY=
# OPENAI_REASONING_EFFORT=low
# Business date used for derived facts like "appeal deadline passed" (defaults to today)
# AGENT_TODAY=2026-10-01
# Run the LLM groundedness judge on every live reply (extra call per turn)
LIVE_JUDGE=false
